# Base58 secret key of the taker / fee payer. Required.
TAKER_PRIVATE_KEY=

# devnet | mainnet
NETWORK=devnet

# Optional. Leave blank to use the network default:
#   devnet  https://api.devnet.solana.com
#   mainnet https://solana-rpc.publicnode.com
SOLANA_RPC_URL=

# Demo 1: WSOL → USDC. Swap TOKEN_IN / TOKEN_OUT for Demo 2.
TOKEN_IN=So11111111111111111111111111111111111111112
# Devnet USDC
TOKEN_OUT=ApUXPfRZ5N5yLEx5ncaNVANJvDfqE5R2QwdqDyPCZCSu
# Mainnet USDC (uncomment when NETWORK=mainnet)
# TOKEN_OUT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

AMOUNT=0.01
SLIPPAGE_BPS=100
